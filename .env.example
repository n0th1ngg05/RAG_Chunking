# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SUPERUSER_PASSWORD=postgres
POSTGRES_DB=docstack

# App roles created by sql/init.sql — set real passwords here, and update
# sql/init.sql's CREATE ROLE statements to match before first boot (or
# change the password after boot with ALTER ROLE ... PASSWORD '...').
APP_DB_USER=app_user
APP_DB_PASSWORD=change_me_in_env
WORKER_DB_USER=worker_user
WORKER_DB_PASSWORD=change_me_in_env

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- JWT ---
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=24h

# --- Ollama ---
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# --- Upload limits ---
MAX_UPLOAD_SIZE_MB=25
# Bare-metal: relative to each service's working directory. Start both
# services from the project root so this resolves to the same folder.
UPLOAD_DIR=./uploads

# --- Node service ---
NODE_PORT=3000
